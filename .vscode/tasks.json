{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile application icon",
            "type": "shell",
            "command": "C:/MinGW/bin/windres.exe",
            "args": [
                "--input",
                "${workspaceFolder}/adn-viewer.rc",
                "--output",
                "${workspaceFolder}/adn-viewer.res.o",
                "--output-format",
                "coff"
            ]
        },
        {
            "label": "Build adn-viewer",
            "type": "shell",
            "command": "C:/MinGW/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/adn-viewer.res.o",
                "-o",
                "${workspaceFolder}/adn-viewer.exe",
                "-mwindows",
                "-static",
                "-static-libgcc",
                "-static-libstdc++",
                "-lgdiplus"
            ],
            "options": {
                "env": {
                    "PATH": "C:\\MinGW\\bin;${env:PATH}"
                }
            },
            "dependsOn": "Compile application icon",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "absolute"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}